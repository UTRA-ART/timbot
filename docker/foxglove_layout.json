{
  "configById": {
    "3D!timbot": {
      "followTf": "base_link",
      "followMode": "follow-position",
      "scene": { "enableStats": false },
      "cameraState": {
        "distance": 25,
        "perspective": true,
        "phi": 45,
        "thetaOffset": 90,
        "targetOffset": [0, 0, 0],
        "target": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "fovy": 45,
        "near": 0.5,
        "far": 5000
      },
      "transforms": { "editable": false },
      "layers": {
        "grid": { "layerId": "foxglove.Grid", "visible": true, "frameId": "map", "size": 60, "divisions": 60 }
      },
      "topics": {
        "/robot_description": { "visible": true },
        "/map": { "visible": true, "colorMode": "map" },
        "/global_costmap/costmap": { "visible": true, "colorMode": "costmap", "alpha": 0.5 },
        "/local_costmap/costmap": { "visible": true, "colorMode": "costmap", "alpha": 0.6 },
        "/scan_modified": { "visible": true, "pointSize": 4, "colorMode": "flat", "flatColor": "#ff3b30" },
        "/plan": { "visible": true, "type": "line", "lineWidth": 0.08, "gradient": ["#2f7bff", "#2f7bff"] },
        "/local_plan": { "visible": true, "type": "line", "lineWidth": 0.08, "gradient": ["#34c759", "#34c759"] },
        "/goal_pose": { "visible": true }
      },
      "publish": {
        "type": "pose",
        "poseTopic": "/goal_pose",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.5,
        "poseEstimateYDeviation": 0.5,
        "poseEstimateThetaDeviation": 0.26
      },
      "imageMode": {}
    },
    "Teleop!timbot": {
      "topic": "/key_vel",
      "publishRate": 10,
      "upButton": { "field": "linear-x", "value": 0.5 },
      "downButton": { "field": "linear-x", "value": -0.5 },
      "leftButton": { "field": "angular-z", "value": 0.6 },
      "rightButton": { "field": "angular-z", "value": -0.6 }
    },
    "Plot!timbot": {
      "paths": [
        { "value": "/cmd_vel.linear.x", "enabled": true, "timestampMethod": "receiveTime", "label": "cmd linear.x" },
        { "value": "/cmd_vel.angular.z", "enabled": true, "timestampMethod": "receiveTime", "label": "cmd angular.z" }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "followingViewWidth": 30
    },
    "RawMessages!timbot": {
      "topicPath": "/odometry/global.pose.pose.position",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "first": "3D!timbot",
    "second": {
      "first": "Teleop!timbot",
      "second": {
        "first": "Plot!timbot",
        "second": "RawMessages!timbot",
        "direction": "column",
        "splitPercentage": 60
      },
      "direction": "column",
      "splitPercentage": 40
    },
    "direction": "row",
    "splitPercentage": 72
  }
}
