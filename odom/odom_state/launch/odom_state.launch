<launch>

    <arg name="launch_state" default="sim"/>

    <!-- Compute local odometry: publish odom frame -->
    
    <node pkg="robot_localization" exec="ekf_localization_node" name="ekf_local" output="screen">
        <remap from="odometry/filtered" to="odometry/local"/>

        <param command="load" from="$(find odom_state)/config/odom_local.yaml"/>
    </node>
   
    <!-- Compute global odometry: publish map frame -->
    <node pkg="robot_localization" exec="ekf_localization_node" name="ekf_global" output="screen">
        <remap from="odometry/filtered" to="odometry/global"/>

        <param command="load" from="$(find odom_state)/config/odom_global.yaml"/>
    </node>

    <!-- <node pkg="odom" type="zero_odom.py" name="zero_odom_node" output="screen"/> -->

    <!-- Establish transform b/w Earth reference and Robot reference -->
    <!-- In scheduler, utm.launch is used. So this is only launched for sim -->
    <group if="$(eval launch_state == 'sim')">
        <node pkg="robot_localization" exec="navsat_transform_node" name="navsat_transform_node" respawn="true">
            <remap from="odometry/filtered" to="odometry/global"/>

            <param command="load" from="$(find odom_state)/config/navsat.yaml"/>
        </node>
    </group>

</launch>