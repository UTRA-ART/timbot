<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>filter_lidar_data</name>
  <version>1.0.0</version>
  <description>
    Dual LiDAR filter node for ramp detection.
    Compares upper and lower LiDAR readings to detect ramps and publishes
    filtered scan data (/scan_modified) and ramp segment points (/ramp_seg).
  </description>
  <maintainer email="harsh@todo.todo">harsh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Message dependencies -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Python dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>laser_geometry</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
