<?xml version="1.0"?>
<package format="3">
  <name>depth_detection</name>
  <version>0.0.1</version>
  <description>Standalone depth-image to PointCloud2 converter for depth-based obstacle and ramp detection.</description>
  <maintainer email="robotswithai@example.com">robotswithai</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
