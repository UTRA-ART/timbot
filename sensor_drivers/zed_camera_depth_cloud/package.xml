  <version>0.0.1</version>
  <description>Standalone depth-image to PointCloud2 converter for the simulated ZED camera.</description>
  <maintainer email="robotswithai@example.com">robotswithai</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
