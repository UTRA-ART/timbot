<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>timbot_launch</name>
  <version>0.0.0</version>
  <description>Central launch orchestrator and custom driver bypass/splitter for ZED 2.0 fallback</description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gazebo_worlds</exec_depend>
  <exec_depend>description</exec_depend>
  <exec_depend>odom_state</exec_depend>
  <exec_depend>filter_lidar_data</exec_depend>
  <exec_depend>nav_stack</exec_depend>
  <exec_depend>load_waypoints</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>